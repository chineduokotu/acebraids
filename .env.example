# Client Environment Variables
# Optional override for the API origin. Defaults to http://localhost:5000 in development
# and same-origin /api in production (vercel.json proxies to the backend).
# Leave blank for the supplied Vercel proxy; an override must be same-site for admin cookies.
# e.g. VITE_API_URL=https://api.acebeautybraids.com
VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
