# Client Environment Variables
# If deploying client separately (e.g. Vercel, Netlify), set this to your backend server URL
# e.g. VITE_API_URL=https://api.acebeautybraids.com or https://acebraids-api.onrender.com
# If hosting client and server on the same domain or via proxy, leave empty or unset.
VITE_API_URL=
